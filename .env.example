# GEMINI_API_KEY: Required for Gemini AI API calls (AI Assistant, Purchase Guardrail, Statement Parser, Executive Briefing).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAYPAL SANDBOX CREDENTIALS: Free sandbox REST API app credentials from https://developer.paypal.com/
# Never commit your real .env file. Alternatively, configure in-app under Settings & Integrations -> PayPal Sandbox.
PAYPAL_CLIENT_ID="MY_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="MY_PAYPAL_SANDBOX_CLIENT_SECRET"
PAYPAL_MODE="sandbox"

# Optional conversion rate for INR ledger <-> PayPal USD checkout orders (default: 84.50)
PAYPAL_INR_PER_USD="84.50"

# APP_URL: The URL where this app is hosted (default: http://localhost:3000)
APP_URL="http://localhost:3000"
